import Foundation
import CryptoKit

// =====================================================
// MARK: - EXECUTION MODE
// =====================================================

public enum DVSMExecutionMode: Sendable {
    case strict          // fully deterministic, audit-grade
    case adaptive        // probabilistic / environmental
    case hybrid          // both with arbitration
}

// =====================================================
// MARK: - NODE CONTEXT
// =====================================================

public struct DVSMNodeContext: Sendable {
    public let nodeID: String
    public let shardKey: String
    public let region: String?
}

// =====================================================
// MARK: - DETERMINISTIC PAYLOAD
// =====================================================

public struct DVSMVectorPayload: Sendable {
    public let id: String
    public let vector: [Float]
    public let timestamp: UInt64
}

// =====================================================
// MARK: - RESULT MODEL
// =====================================================

public enum DVSMResult: Sendable {
    case accepted(root: String)
    case rejected(reason: String)
    case deferred
}

// =====================================================
// MARK: - MERKLE DAG STATE (CORE FIX #1)
// =====================================================

public struct MerkleNode: Sendable {
    public let hash: String
    public let parent: String?
}

// =====================================================
// MARK: - CRYPTO LAYER (DETERMINISTIC ONLY)
// =====================================================

public protocol DVSMCryptoProvider: Sendable {
    func hash(_ data: Data) -> Data
}

public struct SHA256Provider: DVSMCryptoProvider {
    public func hash(_ data: Data) -> Data {
        Data(SHA256.hash(data: data))
    }
}

// =====================================================
// MARK: - AUDIT-GRADE STATE LOG (CORE FIX #2)
// =====================================================

public struct AuditRecord: Sendable {
    public let id: String
    public let payloadHash: String
    public let prevHash: String?
    public let shardRoot: String
    public let timestamp: UInt64
}

// =====================================================
// MARK: - MERKLE DAG ENGINE (CORE FIX #1)
// =====================================================

public actor DVSMMerkleDAG {

    private var tip: String = "GENESIS"
    private let crypto: DVSMCryptoProvider

    public init(crypto: DVSMCryptoProvider) {
        self.crypto = crypto
    }

    public func append(_ data: Data) -> String {
        let prev = tip
        let combined = Data((prev + data.base64EncodedString()).utf8)
        let newHash = crypto.hash(combined).map { String(format: "%02x", $0) }.joined()
        tip = newHash
        return newHash
    }

    public func root() -> String {
        tip
    }
}

// =====================================================
// MARK: - BYZANTINE CONSENSUS LAYER (CORE FIX #3)
// =====================================================

public protocol DVSMConsensusEngine: Sendable {
    func quorum(_ votes: [Bool]) -> Bool
}

public struct PBFTConsensus: DVSMConsensusEngine {

    public init() {}

    public func quorum(_ votes: [Bool]) -> Bool {
        guard !votes.isEmpty else { return false }
        let yes = votes.filter { $0 }.count
        return yes >= (votes.count * 2 / 3)
    }
}

// =====================================================
// MARK: - STRICT GOVERNANCE
// =====================================================

public protocol DVSMGovernance: Sendable {
    func validate(_ payload: DVSMVectorPayload) -> Bool
}

public struct MinimalGovernance: DVSMGovernance {

    public init() {}

    public func validate(_ payload: DVSMVectorPayload) -> Bool {
        !payload.id.isEmpty && !payload.vector.isEmpty
    }
}

// =====================================================
// MARK: - STRICT DETERMINISTIC ENGINE
// =====================================================

public actor DVSMStrictEngine {

    private let dag: DVSMMerkleDAG
    private var auditLog: [AuditRecord] = []

    public init(dag: DVSMMerkleDAG) {
        self.dag = dag
    }

    public func ingest(
        _ payload: DVSMVectorPayload,
        context: DVSMNodeContext
    ) async throws -> DVSMResult {

        let encoded = try JSONEncoder().encode(payload)
        let payloadHash = SHA256.hash(data: encoded)
            .map { String(format: "%02x", $0) }
            .joined()

        let root = await dag.append(encoded)

        let record = AuditRecord(
            id: payload.id,
            payloadHash: payloadHash,
            prevHash: auditLog.last?.payloadHash,
            shardRoot: root,
            timestamp: payload.timestamp
        )

        auditLog.append(record)

        return .accepted(root: root)
    }

    public func verifyChain() -> Bool {
        var prev: String?

        for r in auditLog {
            if let p = prev, r.prevHash != p {
                return false
            }
            prev = r.payloadHash
        }

        return true
    }

    public func currentRoot() async -> String {
        await dag.root()
    }
}

// =====================================================
// MARK: - ADAPTIVE ENGINE (NON-DETERMINISTIC LAYER)
// =====================================================

public actor DVSMAdaptiveEngine {

    public init() {}

    public func propose(
        _ payload: DVSMVectorPayload,
        context: DVSMNodeContext
    ) async -> DVSMResult {

        // probabilistic approximation layer
        let score = Float.random(in: 0...1)

        if score > 0.5 {
            return .accepted(root: "adaptive-\(payload.id)")
        } else {
            return .deferred
        }
    }
}

// =====================================================
// MARK: - SYSTEM ORCHESTRATOR
// =====================================================

public final class DVSMSystem {

    private let strict: DVSMStrictEngine
    private let adaptive: DVSMAdaptiveEngine?
    private let governance: DVSMGovernance
    private let consensus: DVSMConsensusEngine
    private let mode: DVSMExecutionMode

    public init(
        strict: DVSMStrictEngine,
        adaptive: DVSMAdaptiveEngine? = nil,
        governance: DVSMGovernance,
        consensus: DVSMConsensusEngine,
        mode: DVSMExecutionMode = .strict
    ) {
        self.strict = strict
        self.adaptive = adaptive
        self.governance = governance
        self.consensus = consensus
        self.mode = mode
    }

    // =====================================================
    // MARK: - INGEST PIPELINE (FIXED FLOW)
    // =====================================================

    public func ingest(
        _ payload: DVSMVectorPayload,
        context: DVSMNodeContext
    ) async -> DVSMResult {

        // 1. GOVERNANCE GATE
        guard governance.validate(payload) else {
            return .rejected(reason: "Governance failure")
        }

        // 2. ADAPTIVE LAYER
        if mode == .adaptive || mode == .hybrid {
            if let adaptive = adaptive {
                let result = await adaptive.propose(payload, context: context)
                if mode == .adaptive { return result }
            }
        }

        // 3. STRICT LAYER (AUTHORITATIVE)
        do {
            return try await strict.ingest(payload, context: context)
        } catch {
            return .rejected(reason: error.localizedDescription)
        }
    }
}

// =====================================================
// MARK: - SDK ENTRYPOINT
// =====================================================

public final class DVMSDK {

    private let system: DVSMSystem

    public init(system: DVSMSystem) {
        self.system = system
    }

    public func submit(
        id: String,
        vector: [Float],
        shard: String
    ) async -> DVSMResult {

        let payload = DVSMVectorPayload(
            id: id,
            vector: vector,
            timestamp: UInt64(Date().timeIntervalSince1970)
        )

        let context = DVSMNodeContext(
            nodeID: UUID().uuidString,
            shardKey: shard,
            region: nil
        )

        return await system.ingest(payload, context: context)
    }
}
