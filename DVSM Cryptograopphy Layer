// =====================================================
// DVSM SOVEREIGN CRYPTO LAYER
// Atomic • Contextual • Guarded • Hardware-Extensible
// =====================================================
//
// DESIGN GOALS:
// - No key material escapes
// - Cryptography bound to data integrity (Merkle state)
// - Forward secrecy via ratcheting
// - Context-verified execution only
// - Upgrade path to HSM / MPC / ZK systems
//
// =====================================================

import Foundation
import CryptoKit

// =====================================================
// MARK: - SHARD CONTEXT (TRUST ANCHOR)
// =====================================================

public struct DVSMShardContext: Sendable {
    public let shardID: String
    public let merkleRoot: Data
    public let version: UInt64
    public let isVerified: Bool
}

// =====================================================
// MARK: - ERROR MODEL
// =====================================================

public enum DVSMCryptoError: Error, Sendable {
    case invalidContext
    case encryptionFailure
    case decryptionFailure
}

// =====================================================
// MARK: - RATCHET (FORWARD SECRECY CORE)
// =====================================================

struct DVSMRatchet {
    private var state: SymmetricKey

    init(seed: SymmetricKey) {
        self.state = seed
    }

    mutating func advance(context: Data) -> SymmetricKey {
        let next = HKDF<SHA256>.deriveKey(
            inputKeyMaterial: state,
            salt: context,
            info: Data("DVSM-RATCHET".utf8),
            outputByteCount: 32
        )
        state = next
        return next
    }
}

// =====================================================
// MARK: - SOVEREIGN VAULT (NO KEY ESCAPE)
// =====================================================

public actor DVSMSovereignVault {

    private let rootProvider: DVSMRootKeyProvider
    private var ratchets: [String: DVSMRatchet] = [:]

    public init(rootProvider: DVSMRootKeyProvider) {
        self.rootProvider = rootProvider
    }

    // -------------------------------------------------
    // MARK: - CONTEXTUAL KEY DERIVATION
    // -------------------------------------------------

    private func deriveKey(
        id: String,
        shard: DVSMShardContext
    ) async throws -> SymmetricKey {

        guard shard.isVerified else {
            throw DVSMCryptoError.invalidContext
        }

        let root = try await rootProvider.rootKey()

        let context = Data([
            "id:\(id)",
            "shard:\(shard.shardID)",
            "version:\(shard.version)"
        ].joined(separator: "|").utf8)

        let seed = HKDF<SHA256>.deriveKey(
            inputKeyMaterial: root,
            salt: shard.merkleRoot,
            info: context,
            outputByteCount: 32
        )

        var ratchet = ratchets[shard.shardID] ?? DVSMRatchet(seed: seed)
        let derived = ratchet.advance(context: shard.merkleRoot)

        ratchets[shard.shardID] = ratchet
        return derived
    }

    // -------------------------------------------------
    // MARK: - ATOMIC EXECUTION
    // -------------------------------------------------

    public func execute<T: Sendable>(
        id: String,
        shard: DVSMShardContext,
        operation: (inout SymmetricKey) throws -> T
    ) async throws -> T {

        var key = try await deriveKey(id: id, shard: shard)

        defer {
            withUnsafeMutableBytes(of: &key) {
                $0.resetBytes(in: 0..<$0.count)
            }
        }

        return try operation(&key)
    }
}

// =====================================================
// MARK: - ROOT KEY PROVIDER (EXTENSIBLE TRUST SOURCE)
// =====================================================

public protocol DVSMRootKeyProvider: Sendable {
    func rootKey() async throws -> SymmetricKey
}

// -----------------------------------------------------
// DEV IMPLEMENTATION (REPLACE IN PROD)
// -----------------------------------------------------

public struct DVSMInMemoryRootProvider: DVSMRootKeyProvider {

    private let key: SymmetricKey

    public init() {
        self.key = SymmetricKey(size: .bits256)
    }

    public func rootKey() async throws -> SymmetricKey {
        key
    }
}

// =====================================================
// MARK: - CRYPTO ENGINE (KEYLESS EXECUTION)
// =====================================================

public final class DVSMCryptoEngine {

    private let vault: DVSMSovereignVault

    public init(vault: DVSMSovereignVault) {
        self.vault = vault
    }

    public func encrypt(
        _ data: Data,
        id: String,
        shard: DVSMShardContext
    ) async throws -> Data {

        try await vault.execute(id: id, shard: shard) { key in
            let sealed = try AES.GCM.seal(data, using: key)
            guard let combined = sealed.combined else {
                throw DVSMCryptoError.encryptionFailure
            }
            return combined
        }
    }

    public func decrypt(
        _ data: Data,
        id: String,
        shard: DVSMShardContext
    ) async throws -> Data {

        try await vault.execute(id: id, shard: shard) { key in
            let box = try AES.GCM.SealedBox(combined: data)
            return try AES.GCM.open(box, using: key)
        }
    }
}
}
