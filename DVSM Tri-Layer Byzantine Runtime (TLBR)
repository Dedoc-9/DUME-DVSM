// =====================================================
// DVSM / DUME UNIFIED BYZANTINE RUNTIME SYSTEM
// =====================================================
// SINGLE-FILE ARCHITECTURE (CORE + CONSENSUS + DAG)
// =====================================================
//
// ROLE:
// - Deterministic execution engine
// - Merkle DAG state construction
// - Adaptive proposal layer (non-authoritative)
// - Byzantine consensus finalization layer (PBFT-style model)
//
// IMPORTANT CORRECTION:
// Strict engine NEVER finalizes state.
// Consensus determines truth.
// =====================================================

import Foundation
import CryptoKit

// =====================================================
// MARK: - EXECUTION MODEL
// =====================================================

public enum DVSMExecutionMode: Sendable {
    case strict
    case adaptive
    case hybrid
}

// =====================================================
// MARK: - NODE CONTEXT
// =====================================================

public struct DVSMNodeContext: Sendable {
    public let nodeID: String
    public let shardKey: String
    public let region: String?
}

// =====================================================
// MARK: - PAYLOAD
// =====================================================

public struct DVSMVectorPayload: Sendable {
    public let id: String
    public let vector: [Float]
    public let timestamp: UInt64
}

// =====================================================
// MARK: - RESULT MODEL
// =====================================================

public enum DVSMResult: Sendable {
    case accepted(finalRoot: String)
    case rejected(reason: String)
    case deferred
}

// =====================================================
// MARK: - CRYPTO PROVIDER
// =====================================================

public protocol DVSMCryptoProvider: Sendable {
    func hash(_ data: Data) -> Data
}

public struct SHA256Provider: DVSMCryptoProvider {
    public func hash(_ data: Data) -> Data {
        Data(SHA256.hash(data: data))
    }
}

// =====================================================
// MARK: - MERKLE DAG (LOCAL STATE BUILDER)
// =====================================================

public actor DVSMMerkleDAG {

    private var tip: String = "GENESIS"
    private let crypto: DVSMCryptoProvider

    public init(crypto: DVSMCryptoProvider) {
        self.crypto = crypto
    }

    public func append(_ data: Data) -> String {
        let prev = tip
        let combined = Data((prev + data.base64EncodedString()).utf8)
        let newHash = crypto.hash(combined)
            .map { String(format: "%02x", $0) }
            .joined()

        tip = newHash
        return newHash
    }

    public func root() -> String {
        tip
    }
}

// =====================================================
// MARK: - AUDIT RECORD
// =====================================================

public struct AuditRecord: Sendable {
    public let id: String
    public let payloadHash: String
    public let prevHash: String?
    public let shardRoot: String
    public let timestamp: UInt64
}

// =====================================================
// MARK: - STRICT DETERMINISTIC ENGINE
// =====================================================

public actor DVSMStrictEngine {

    private let dag: DVSMMerkleDAG
    private var auditLog: [AuditRecord] = []

    public init(dag: DVSMMerkleDAG) {
        self.dag = dag
    }

    /// Produces a deterministic candidate state (NOT final)
    public func execute(
        _ payload: DVSMVectorPayload,
        context: DVSMNodeContext
    ) async throws -> (root: String, record: AuditRecord) {

        let encoded = try JSONEncoder().encode(payload)

        let payloadHash = SHA256.hash(data: encoded)
            .map { String(format: "%02x", $0) }
            .joined()

        let root = await dag.append(encoded)

        let record = AuditRecord(
            id: payload.id,
            payloadHash: payloadHash,
            prevHash: auditLog.last?.payloadHash,
            shardRoot: root,
            timestamp: payload.timestamp
        )

        auditLog.append(record)

        return (root, record)
    }

    public func verifyChain() -> Bool {
        var prev: String?

        for r in auditLog {
            if let p = prev, r.prevHash != p {
                return false
            }
            prev = r.payloadHash
        }

        return true
    }
}

// =====================================================
// MARK: - ADAPTIVE ENGINE (NON-DETERMINISTIC)
// =====================================================

public actor DVSMAdaptiveEngine {

    public init() {}

    public func propose(
        _ payload: DVSMVectorPayload,
        context: DVSMNodeContext
    ) async -> String {

        let score = Float.random(in: 0...1)

        return score > 0.5
            ? "adaptive-accept-\(payload.id)"
            : "adaptive-defer-\(payload.id)"
    }
}

// =====================================================
// MARK: - BYZANTINE CONSENSUS TYPES (PBFT MODEL)
// =====================================================

public enum ConsensusPhase: Sendable {
    case prePrepare
    case prepare
    case commit
}

public enum ConsensusDecision: Sendable {
    case commit(root: String)
    case reject(reason: String)
    case pending
}

// =====================================================
// MARK: - BYZANTINE CONSENSUS ENGINE (ABSTRACT PBFT)
// =====================================================
//
// NOTE:
// This is a protocol-level representation of PBFT,
// NOT a full network implementation.
// Real implementation requires node networking layer.
// =====================================================

public protocol DVSMByzantineConsensus: Sendable {

    func propose(root: String) async -> ConsensusDecision

    func broadcastPrepare(root: String) async -> Int

    func broadcastCommit(root: String) async -> Int

    func finalize(root: String, commitCount: Int, totalNodes: Int) -> ConsensusDecision
}

// =====================================================
// MARK: - SIMPLE PBFT MODEL (REFERENCE IMPLEMENTATION)
// =====================================================

public struct PBFTConsensus: DVSMByzantineConsensus {

    public init() {}

    public func propose(root: String) async -> ConsensusDecision {
        .pending
    }

    public func broadcastPrepare(root: String) async -> Int {
        Int.random(in: 2...5)
    }

    public func broadcastCommit(root: String) async -> Int {
        Int.random(in: 2...5)
    }

    public func finalize(root: String, commitCount: Int, totalNodes: Int) -> ConsensusDecision {

        guard totalNodes > 0 else {
            return .reject(reason: "No nodes available")
        }

        let threshold = (2 * totalNodes) / 3

        if commitCount >= threshold {
            return .commit(root: root)
        } else {
            return .reject(reason: "Insufficient Byzantine quorum")
        }
    }
}

// =====================================================
// MARK: - SYSTEM ORCHESTRATOR (CORRECTED FLOW)
// =====================================================

public final class DVSMSystem {

    private let strict: DVSMStrictEngine
    private let adaptive: DVSMAdaptiveEngine?
    private let consensus: DVSMByzantineConsensus
    private let mode: DVSMExecutionMode

    public init(
        strict: DVSMStrictEngine,
        adaptive: DVSMAdaptiveEngine? = nil,
        consensus: DVSMByzantineConsensus,
        mode: DVSMExecutionMode = .strict
    ) {
        self.strict = strict
        self.adaptive = adaptive
        self.consensus = consensus
        self.mode = mode
    }

    // =====================================================
    // MARK: - INGEST PIPELINE (CONSENSUS-AUTHORITY MODEL)
    // =====================================================

    public func ingest(
        _ payload: DVSMVectorPayload,
        context: DVSMNodeContext
    ) async -> DVSMResult {

        // 1. ADAPTIVE LAYER (optional hinting only)
        if mode == .adaptive || mode == .hybrid {
            _ = await adaptive?.propose(payload, context: context)
        }

        // 2. STRICT EXECUTION (candidate state)
        do {
            let (root, _) = try await strict.execute(payload, context: context)

            // 3. CONSENSUS PHASE 1: PREPARE
            let prepareVotes = await consensus.broadcastPrepare(root: root)

            // 4. CONSENSUS PHASE 2: COMMIT
            let commitVotes = await consensus.broadcastCommit(root: root)

            // 5. FINAL DECISION
            let decision = consensus.finalize(
                root: root,
                commitCount: commitVotes,
                totalNodes: prepareVotes
            )

            switch decision {
            case .commit(let finalRoot):
                return .accepted(finalRoot: finalRoot)

            case .reject(let reason):
                return .rejected(reason: reason)

            case .pending:
                return .deferred
            }

        } catch {
            return .rejected(reason: error.localizedDescription)
        }
    }
}

// =====================================================
// MARK: - SDK ENTRYPOINT
// =====================================================

public final class DVMSDK {

    private let system: DVSMSystem

    public init(system: DVSMSystem) {
        self.system = system
    }

    public func submit(
        id: String,
        vector: [Float],
        shard: String
    ) async -> DVSMResult {

        let payload = DVSMVectorPayload(
            id: id,
            vector: vector,
            timestamp: UInt64(Date().timeIntervalSince1970)
        )

        let context = DVSMNodeContext(
            nodeID: UUID().uuidString,
            shardKey: shard,
            region: nil
        )

        return await system.ingest(payload, context: context)
    }
}
}
